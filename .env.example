# Để trống cả hai khóa thì app chấm bằng bộ mẫu, đủ để thử giao diện.
# Có khóa nào thì dùng khóa đó. Nếu có cả hai, ưu tiên Gemini.
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_MODEL=gpt-4o-mini

# Không bắt buộc. MyMemory tăng hạn mức từ 5.000 lên 50.000 ký tự/ngày nếu có email liên hệ.
